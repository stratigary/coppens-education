---
import '../styles/global.css';
import { site, courses } from '../lib/data.js';
import { url } from '../lib/render.js';
const isPreview = import.meta.env.BASE_URL !== '/';
interface Props { title: string; description?: string; active?: string }
const { title, description = `${site.teacher}'s science classes at ${site.school}: daily class calendars, notes, textbooks and tools.`, active = '' } = Astro.props;
const pageTitle = title === 'Today' ? `coppens.education · ${site.teacher}` : `${title} · coppens.education`;
const nav = [
  { id: 'home', href: url('/'), label: 'Today' },
  ...courses.map(c => ({ id: c.id, href: url(`/${c.id}/`), label: c.short })),
  { id: 'tools', href: url('/tools/'), label: 'Tools' },
  { id: 'books', href: url('/books/'), label: 'Books' },
  { id: 'contact', href: url('/contact/'), label: 'Contact' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <meta name="color-scheme" content="light dark" />
  <meta name="theme-color" content="#EEF1E8" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#121915" media="(prefers-color-scheme: dark)" />
  <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
  {isPreview ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />}
  <script is:inline>
    try { var t = localStorage.getItem('theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:ital,wght@0,400;0,500;0,700;1,400&family=DM+Mono:wght@400;500&family=Young+Serif&display=swap" />
</head>
<body>
  <a class="skip" href="#main">Skip to main content</a>
  <header class="site">
    <div class="wrap">
      <a class="mark" href={url('/')} aria-label="coppens.education, home"><b>coppens</b><span>.education</span></a>
      <nav class="main" aria-label="Main">
        <ul>
          {nav.map(n => <li><a href={n.href} aria-current={n.id === active ? 'page' : undefined}>{n.label}</a></li>)}
        </ul>
      </nav>
      <div class="head-actions">
        <button class="icon-btn" type="button" id="theme-toggle" aria-label="Dark theme" aria-pressed="false">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"/></svg>
        </button>
        <a class="btn" href={site.classroomUrl} target="_blank" rel="noopener">Google Classroom <span class="arrow" aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span></a>
      </div>
    </div>
  </header>
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <footer class="site">
    <div class="wrap">
      <p>{site.teacher} · <a href={`mailto:${site.email}`}>{site.email}</a></p>
      <p>Assignments are posted and turned in on Google Classroom.</p>
    </div>
  </footer>
  <script>
    import '../scripts/topo.js';
    const btn = document.getElementById('theme-toggle');
    const root = document.documentElement;
    const isDark = () => root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
    const sync = () => btn?.setAttribute('aria-pressed', String(isDark()));
    sync();
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', sync);
    btn?.addEventListener('click', () => {
      const next = isDark() ? 'light' : 'dark';
      root.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch (e) {}
      sync();
    });
  </script>
</body>
</html>
