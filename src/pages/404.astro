---
import Base from '../layouts/Base.astro';
import { url } from '../lib/render.js';
---
<Base title="Page not found">
  <div class="band"><canvas class="topo" aria-hidden="true"></canvas><div class="wrap">
    <p class="eyebrow">Off the map</p>
    <h1>That page isn’t here</h1>
    <p class="lede">It may have moved when the site was rebuilt. Try <a href={url('/')}>today’s classes</a> or the <a href={url('/tools/')}>tools page</a>.</p>
  </div></div>
</Base>
