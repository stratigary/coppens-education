---
import Base from '../../layouts/Base.astro';
import LogisticExplorer from '../../components/LogisticExplorer.astro';
import { url } from '../../lib/render.js';
---
<Base title="Carrying capacity explorer" active="tools">
  <div class="band c-river"><canvas class="topo" aria-hidden="true"></canvas><div class="wrap">
    <p class="eyebrow"><a href={url('/tools/')}>Tools</a> / Population ecology</p>
    <h1>Carrying capacity explorer</h1>
    <p class="lede">Move the sliders to see how the growth rate (r), the carrying capacity (K) and the starting population (N₀) shape logistic growth, and how it compares with unlimited exponential growth.</p>
  </div></div>
  <section class="block"><div class="wrap">
    <LogisticExplorer />
    <div class="prose" style="margin-top:24px">
      <h2>Things to try</h2>
      <ul class="bul">
        <li>Double r. Does the population reach K sooner? Does K change?</li>
        <li>Start N₀ above K/2. Where is growth fastest now?</li>
        <li>Find the generation where the exponential curve leaves the graph. Why can’t real populations keep doing that?</li>
      </ul>
    </div>
  </div></section>
</Base>
