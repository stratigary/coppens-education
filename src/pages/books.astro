---
import Base from '../layouts/Base.astro';
import { courseById, site } from '../lib/data.js';
import booksData from '../data/books.json';
const books = booksData.books.filter(b => b.show !== false && courseById(b.course)?.enabled !== false)
  .sort((a, b) => Number(a.rarelyUsed) - Number(b.rarelyUsed));
---
<Base title="Digital textbooks" active="books">
  <div class="band"><canvas class="topo" aria-hidden="true"></canvas><div class="wrap">
    <p class="eyebrow">Books</p>
    <h1>Digital textbooks</h1>
    <p class="lede">The book files live in Google Drive. Open them while signed in to your school Google account. They won’t open from a personal account.</p>
  </div></div>
  <section class="block"><div class="wrap">
    <div class="books">
      {books.map(b => { const c = courseById(b.course); return (
        <article class={`book c-${c?.color || 'river'}${b.rarelyUsed ? ' rare' : ''}`}>
          <div class="spine" aria-hidden="true"></div>
          <div>
            {c && <span class="tag sm">{c.short}</span>}
            <h3>{b.title}</h3>
            <p class="by">{[b.authors, b.edition].filter(Boolean).join(' · ')}</p>
            <p>{b.note}</p>
            {b.url
              ? <a class="btn" href={b.url} target="_blank" rel="noopener">Open in Drive <span class="arrow" aria-hidden="true">↗</span><span class="sr-only">(opens in a new tab)</span></a>
              : <p class="access">Ask {site.teacher} for access to this book.</p>}
            {b.rarelyUsed && <p class="access">Rarely used: reference only.</p>}
            {b.url && <p class="access">School accounts only</p>}
          </div>
        </article>
      ); })}
    </div>
  </div></section>
</Base>
