---
import Base from '../layouts/Base.astro';
import { site } from '../lib/data.js';
---
<Base title="Contact" active="contact">
  <div class="band"><canvas class="topo" aria-hidden="true"></canvas><div class="wrap">
    <p class="eyebrow">Contact</p>
    <h1>Get in touch</h1>
    <p class="lede">Students and parents: email is the best way to reach {site.teacher}.</p>
  </div></div>
  <section class="block"><div class="wrap prose">
    <p><a class="big-link" href={`mailto:${site.email}`}>{site.email}</a></p>
    <p>For a question about a specific assignment, students can also leave a private comment on it in Google Classroom.</p>
    <p>Please include your name, your class and, for IB Biology, your section (Blue or Gold).</p>
  </div></section>
</Base>
